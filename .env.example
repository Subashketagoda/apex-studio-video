# ==============================================================
# YouTube Shorts Pipeline Configuration
# ==============================================================

# LLM Providers (Provide at least one: GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Preferred LLM Provider: 'gemini' or 'openai'
DEFAULT_LLM_PROVIDER=gemini

# Audio / TTS Settings
# Options: 'edge-tts' (free, no API key needed) or 'elevenlabs'
TTS_PROVIDER=edge-tts
# Edge-TTS Voice options: en-US-ChristopherNeural, en-US-GuyNeural, en-US-JennyNeural, en-GB-SoniaNeural
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Optional ElevenLabs (if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stock Footage API (Pexels - Free API key from https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 (OAuth client secrets JSON file for publishing)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json

# Video Output Directory
OUTPUT_DIR=outputs
